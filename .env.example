# Backend cameras
CAMERA_SOURCE_ELEVTOP=0
CAMERA_SOURCE_ELEVSIDE=rtsp://127.0.0.1:8554/ELEV-SIDE

# Person-presence gating (TOP 카메라, ELEV-TOP 전용) — 배경 차분 기반, 값은 임시 기본치
# (실제 카메라 설치 후 실측 튜닝 필요, .agentfiles/architecture.md TBD 참고)
PRESENCE_POLL_INTERVAL_SECONDS=0.2
PRESENCE_FOREGROUND_RATIO_THRESHOLD=0.05
PRESENCE_ENTRY_CONFIRM_SECONDS=0.5
PRESENCE_EXIT_GRACE_SECONDS=3.0

# SIDE(ELEV-SIDE) overflow detection — services/overflowDetectionService.py
# Which physical bin (binId/binType) the single ROI in models/trashoverflow/roi.json
# actually points at. Model weights (bestSide.pt) are gitignored; missing them just
# disables this service, nothing else breaks.
OVERFLOW_BIN_ID=BIN-GENERAL
OVERFLOW_BIN_TYPE=normal

# Safe local development database defaults
MONGO_HOST=localhost
DB_PORT=27020
DB_NAME=sortMasterTest
DB_USER=
DB_PASSWORD=

# Docker Compose backend only (container network address)
COMPOSE_MONGO_HOST=mongo
COMPOSE_DB_PORT=27017
COMPOSE_DB_NAME=sortMasterTest
COMPOSE_DB_USER=
COMPOSE_DB_PASSWORD=

# Optional GPU-service profiles
GPU_DEVICE_ID=0
JUPYTER_PORT=8899
JUPYTER_TOKEN=replace-with-a-random-token
LLM_PORT=8099
LLM_MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct-FP8
HF_TOKEN=

# Automatic daily/weekly report RPA (RPAs/reportAutomation)
RPA_REPORT_ENABLED=false
RPA_REPORT_TIMEZONE=Asia/Seoul
RPA_DAILY_SEND_TIME=09:00
RPA_WEEKLY_SEND_DAY=MON
RPA_WEEKLY_SEND_TIME=09:10
# Docker report-scheduler가 예약 시각 도달 여부를 확인하는 간격
RPA_SCHEDULER_POLL_SECONDS=30
# 대시보드에서 아직 수신 이메일을 설정하지 않았을 때만 사용하는 CLI 호환 폴백
RPA_REPORT_RECIPIENTS=
RPA_REPORT_RECIPIENT_GROUP=operations
# Gmail/Google Workspace 발신 계정의 전체 이메일 주소
RPA_REPORT_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# RPA_REPORT_FROM과 같은 전체 이메일 주소
SMTP_USER=
# Google 계정 기본 비밀번호가 아니라 2단계 인증으로 발급한 앱 비밀번호
SMTP_PASSWORD=
SMTP_USE_TLS=true
SORTMASTER_API_BASE_URL=http://localhost:8047
SORTMASTER_WEB_BASE_URL=http://localhost:8047
RPA_RETRY_DELAYS_SECONDS=60,300,900
RPA_REQUEST_TIMEOUT_SECONDS=15

# FULL 감지 기반 수거 업무 자동화 (RPAs/collectionAutomation)
RPA_COLLECTION_ENABLED=false
RPA_COLLECTION_ASSIGNEE_EMAIL=
RPA_COLLECTION_MANAGER_EMAIL=
RPA_COLLECTION_REMINDER_MINUTES=10
RPA_COLLECTION_ESCALATION_MINUTES=20
RPA_COLLECTION_POLL_SECONDS=30
RPA_COLLECTION_RETRY_SECONDS=60
